{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "generators": {
    "@nx/angular:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "cypress"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "style": "css"
    },
    "@nx/angular:component": {
      "style": "css",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:scam": {
      "type": "component"
    },
    "@nx/angular:scam-directive": {
      "type": "directive"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "@nx/jest:jest": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true,
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "@nx/js:release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ],
    "component-test": [
      {
        "filter": {
          "plugin": "@nx/cypress/plugin"
        },
        "options": {
          "config-file": "./cypress.config.ts"
        }
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/workspace.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tslint.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/babel.config.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "parallel": 3,
  "useInferencePlugins": false,
  "defaultBase": "main",
  "release": {
    "groups": {
      "default": {
        "projects": [
          "cypress-harness",
          "microwave",
          "operators",
          "playwright-ct-angular",
          "rx-computed"
        ],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "{projectName}-{version}"
        }
      },
      "swc-angular": {
        "projects": ["swc-angular", "swc-angular-plugin"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "swc-angular-{version}"
        }
      }
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false
    },
    "git": {
      "commit": true,
      "commitArgs": "--no-verify"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/game-of-life/**/*",
        "apps/sandbox/**/*",
        "packages/cypress-harness/**/*",
        "packages/microwave/**/*",
        "packages/operators/**/*",
        "packages/playwright-ct-angular/**/*",
        "packages/rx-computed/**/*",
        "packages/swc-angular/**/*",
        "tests/cypress-harness-e2e/**/*",
        "tests/cypress-harness-wide/**/*",
        "tests/swc-angular-debug/**/*",
        "tests/swc-angular-wide/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      },
      "include": ["packages/swc-angular/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/sandbox/**/*",
        "packages/cypress-harness/**/*",
        "packages/microwave/**/*",
        "packages/operators/**/*",
        "packages/playwright-ct-angular/**/*",
        "packages/rx-computed/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "component-test",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": ["packages/microwave/**/*", "tests/cypress-harness-wide/**/*"]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": ["tests/cypress-harness-e2e/**/*"]
    },
    {
      "plugin": "@nx/rollup/plugin",
      "options": {
        "buildTargetName": "build"
      }
    }
  ]
}
